{
  "name": "SyncClipboard Server",
  "version": "0.1.2",
  "slug": "syncclipboard_server",
  "url": "https://github.com/autofeet/synclipboard-sever-for-HA",
  "description": "Cross-platform clipboard sync with independent authentication and persistent history",
  "arch": ["amd64"],
  "startup": "application",
  "boot": "manual",
  "init": false,
  "ports": {"5033/tcp": 5033},
  "ports_description": {"5033/tcp": "SyncClipboard HTTP API (trusted LAN only)"},
  "options": {"username": "syncclipboard", "password": ""},
  "schema": {
    "username": "match(^[A-Za-z0-9_-]{1,64}$)",
    "password": "password"
  }
}
